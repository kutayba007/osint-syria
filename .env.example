# ============================================
# 🇸🇾 OSINT Syria - Environment Variables
# ============================================
# Copy this to .env and fill in your credentials

# --- Telegram API (get from https://my.telegram.org) ---
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
TG_PHONE_NUMBER=+963XXXXXXXXX

# --- Telegram Alert Bot (from @BotFather) ---
TG_BOT_TOKEN=your_bot_token_here
TG_ALERT_CHAT_ID=your_chat_id_here

# --- Groq Cloud API (free, get from https://console.groq.com) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Supabase (free, get from https://supabase.com) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --- ACLED API (free, get key from https://acleddata.com) ---
ACLED_KEY=your_acled_api_key_here

# --- Discord Webhook (free, for alerts) ---
# Create webhook in Discord: Channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# --- Google Drive API (optional, for media archiving) ---
GDRIVE_CREDENTIALS_PATH=
